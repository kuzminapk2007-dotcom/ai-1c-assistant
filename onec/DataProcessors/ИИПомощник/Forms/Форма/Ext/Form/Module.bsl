
&НаКлиенте
Процедура ПроверитьСвязь(Команда)

    Если ПустаяСтрока(Запрос) Тогда
        Результат = "Введите запрос.";
        Возврат;
    КонецЕсли;

    Попытка
        Соединение = Новый HTTPСоединение("127.0.0.1", 5000);

        ЗапросHTTP = Новый HTTPЗапрос("/parse");
        ЗапросHTTP.УстановитьТелоИзСтроки(Запрос, "utf-8");

        ОтветHTTP = Соединение.ОтправитьДляОбработки(ЗапросHTTP);          
		
        ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоОтвета);
		ДанныеОтвета = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();  
		
		Результат = "Тип отчета: " + Строка(ДанныеОтвета.report_type)
			+ Символы.ПС + "Период: " + Строка(ДанныеОтвета.period)
    		+ Символы.ПС + "Группировка: " + Строка(ДанныеОтвета.group_by);
			
			Если ДанныеОтвета.report_type = "продажи" Тогда
				КлючВарианта = "";
				Если ДанныеОтвета.group_by = "менеджеры" Тогда
					КлючВарианта = "ПоМенеджерам";
				ИначеЕсли ДанныеОтвета.group_by = "товары" Тогда
					КлючВарианта = "ПоТоварам";
				КонецЕсли;
				Если НЕ ПустаяСтрока(КлючВарианта) Тогда
					ПараметрыФормы = Новый Структура;
					ПараметрыФормы.Вставить("КлючВарианта", КлючВарианта);
					ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
					
					ОткрытьФорму(
					"Отчет.ОтчетПоПродажам.Форма",
					ПараметрыФормы,
					ЭтаФорма,
					КлючВарианта);
				КонецЕсли;
			КонецЕсли;

	Исключение                            
        Результат = "Не удалось подключиться к Python-сервису."
            + Символы.ПС
            + ОписаниеОшибки();
    КонецПопытки;

КонецПроцедуры           	
